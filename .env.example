# Stock Market Game -- server configuration.
#
#   cp .env.example .env
#
# Every variable is optional except STOCKGAME_SECRET_KEY in production.
# This file is committed; .env is not. Never put a real secret in here.

# ---------------------------------------------------------------- security
# REQUIRED IN PRODUCTION. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the server generates a throwaway key and every session dies on
# restart.
STOCKGAME_SECRET_KEY=

# How long a login lasts before the player must sign in again (hours).
STOCKGAME_SESSION_TTL_HOURS=336

# Argon2id cost. Higher = slower logins and more expensive to crack offline.
# The defaults follow OWASP guidance; lower them only on tiny hardware.
STOCKGAME_ARGON2_TIME_COST=3
STOCKGAME_ARGON2_MEMORY_COST=65536
STOCKGAME_ARGON2_PARALLELISM=2

# Failed logins per IP per window, and orders per player per window.
STOCKGAME_AUTH_RATE_LIMIT=10
STOCKGAME_AUTH_RATE_WINDOW_SECONDS=60
STOCKGAME_ORDER_RATE_LIMIT=30
STOCKGAME_ORDER_RATE_WINDOW_SECONDS=10
STOCKGAME_MAX_CONNECTIONS_PER_USER=5

# Set true ONLY when behind a reverse proxy you control. If true, the server
# believes X-Forwarded-For -- which anyone could forge if there is no proxy.
STOCKGAME_TRUST_PROXY_HEADERS=false

# -------------------------------------------------------------- networking
STOCKGAME_HOST=127.0.0.1
STOCKGAME_PORT=8765

# Comma-separated browser origins. The terminal client does not need this.
STOCKGAME_CORS_ORIGINS=

# ----------------------------------------------------------------- storage
# SQLite by default. For PostgreSQL:
#   postgresql+asyncpg://user:password@host:5432/stockgame
STOCKGAME_DATABASE_URL=sqlite+aiosqlite:///./data/stockgame.sqlite3
STOCKGAME_DATA_DIR=./data

# -------------------------------------------------------------- simulation
# Cash every new account starts with.
STOCKGAME_STARTING_CASH=100000

# Seconds of real time between price ticks. Lower = livelier and more CPU.
STOCKGAME_TICK_SECONDS=2.0

# Real seconds per simulated trading day. 3600 = one market day per hour,
# so a simulated year takes about ten and a half real days.
STOCKGAME_DAY_SECONDS=3600

# Ticks aggregated into one intraday candle (the 1D chart's resolution).
STOCKGAME_TICKS_PER_CANDLE=15

# Days of end-of-day history generated when the market is first created.
# Ignored on every subsequent start -- the market is persisted.
STOCKGAME_HISTORY_DAYS=400

# Changing this after the first run does nothing; the world already exists.
STOCKGAME_MARKET_SEED=20260101

# Commission per trade, in dollars. 0 keeps the game frictionless.
STOCKGAME_COMMISSION=0

# Set false to start with the market closed.
STOCKGAME_MARKET_OPEN=true

# --------------------------------------------------------- leaderboards
STOCKGAME_LEADERBOARD_INTERVAL_SECONDS=30
STOCKGAME_LEADERBOARD_SIZE=100
STOCKGAME_SEASON_LENGTH_DAYS=30

# -------------------------------------------------------------- operations
STOCKGAME_LOG_LEVEL=INFO
STOCKGAME_LOG_JSON=false
# STOCKGAME_LOG_FILE=./logs/stockgame.log

# Mounts /api/admin/*. Still requires a session belonging to an admin account.
STOCKGAME_ADMIN_ENABLED=true

# Enables /docs and verbose errors. Never true in production.
STOCKGAME_DEBUG=false
